{
  "rules": {
    "users": {
      "$uid": {
        ".read": true,
        "state": {
          "pools": {
            ".write": true
          },
          "participants": {
            ".write": true
          },
          "globalSettings": {
            ".write": "$uid === auth.uid || (auth.token != null && auth.token.email === 'kofc14269@gmail.com')"
          },
          "activePoolId": {
            ".write": "$uid === auth.uid || (auth.token != null && auth.token.email === 'kofc14269@gmail.com')"
          }
        }
      }
    },
    "state": {
      ".read": true,
      ".write": "auth.token != null && auth.token.email === 'kofc14269@gmail.com'"
    }
  }
}